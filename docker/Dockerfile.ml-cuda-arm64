ARG CUDA_DEVEL_IMAGE=nvcr.io/nvidia/cuda:13.0.1-cudnn-devel-ubuntu24.04
ARG CUDA_RUNTIME_IMAGE=nvcr.io/nvidia/cuda:13.0.1-cudnn-runtime-ubuntu24.04

# The upstream image's Python is built on Debian trixie and links its OpenSSL 3.5, which Ubuntu 24.04 lacks, so the
# interpreter and venv are built here from the same uv.lock with uv's self-contained Python instead of copied over.
FROM ${CUDA_DEVEL_IMAGE} AS python-env

ENV UV_PYTHON_INSTALL_DIR=/opt/python \
    UV_PYTHON_PREFERENCE=only-managed \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    VIRTUAL_ENV=/opt/venv

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
      ca-certificates \
      g++ \
      git \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.8.15 /uv /uvx /bin/

WORKDIR /build
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=machine-learning/uv.lock,target=uv.lock \
    --mount=type=bind,source=machine-learning/pyproject.toml,target=pyproject.toml \
    uv venv --python 3.13 /opt/venv \
    && uv sync --frozen --extra cpu --no-dev --no-editable --no-install-project --no-progress --active

FROM python-env AS ort-builder

# renovate: datasource=github-releases depName=microsoft/onnxruntime
ARG ORT_VERSION=v1.26.0

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
      build-essential \
      ccache \
      ninja-build \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN uv pip install --no-progress "cmake>=3.28,<4" packaging setuptools wheel

ENV PATH=/opt/venv/bin:$PATH

WORKDIR /build
RUN git clone \
      --branch "${ORT_VERSION}" \
      --depth 1 \
      --recurse-submodules \
      --shallow-submodules \
      https://github.com/microsoft/onnxruntime.git

WORKDIR /build/onnxruntime
RUN --mount=type=cache,id=ort-build-arm64-cuda130-sm121-py313,target=/build/output \
    rm -rf /build/output/Release/dist \
    && ./build.sh \
      --allow_running_as_root \
      --build \
      --build_dir /build/output \
      --build_wheel \
      --cmake_generator Ninja \
      --cmake_extra_defines CMAKE_CUDA_ARCHITECTURES=121 onnxruntime_QUICK_BUILD=ON onnxruntime_BUILD_UNIT_TESTS=OFF \
      --compile_no_warning_as_error \
      --config Release \
      --cuda_home /usr/local/cuda \
      --cudnn_home /usr/local/cuda \
      --disable_generation_ops \
      --parallel 16 \
      --skip_tests \
      --update \
      --use_cuda \
    && mkdir -p /tmp/ort-wheel \
    && cp /build/output/Release/dist/*.whl /tmp/ort-wheel/

FROM python-env AS venv

COPY --from=ort-builder /tmp/ort-wheel /tmp/ort-wheel
RUN uv pip uninstall onnxruntime \
    && uv pip install --no-deps --no-progress /tmp/ort-wheel/*.whl \
    && /opt/venv/bin/python -c \
      "import onnxruntime as ort; assert 'CUDAExecutionProvider' in ort.get_available_providers(), ort.get_available_providers()"

FROM ${CUDA_RUNTIME_IMAGE}

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
      ca-certificates \
      libgl1 \
      libglib2.0-0 \
      libgomp1 \
      libmimalloc2.0 \
      tini \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s /usr/lib/aarch64-linux-gnu/libmimalloc.so.2 /usr/lib/libmimalloc.so.2

COPY --from=python-env /opt/python /opt/python
COPY --from=venv /opt/venv /opt/venv

WORKDIR /usr/src
COPY machine-learning/scripts/healthcheck.py /usr/src/healthcheck.py
COPY machine-learning/immich_ml /usr/src/immich_ml

ENV DEVICE=cuda \
    LD_PRELOAD=/usr/lib/libmimalloc.so.2 \
    MACHINE_LEARNING_CACHE_FOLDER=/cache \
    MACHINE_LEARNING_MODEL_ARENA=false \
    PATH=/opt/venv/bin:$PATH \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/usr/src \
    PYTHONUNBUFFERED=1 \
    TRANSFORMERS_CACHE=/cache \
    HF_HOME=/cache/hf-cache \
    CUDA_CACHE_PATH=/cache/jit/cuda \
    VIRTUAL_ENV=/opt/venv

ENTRYPOINT ["tini", "--"]
CMD ["python", "-m", "immich_ml"]
HEALTHCHECK CMD python3 healthcheck.py
